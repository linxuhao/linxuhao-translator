# docker compose 会自动读同目录的 .env。所有值都有内置默认, 这里列的是"你可能要动"的那些。

# GPU 层门面所在主机 (gpu-runtime 的 facade, 9041); 容器内不走 MagicDNS, 所以还要它的地址
GPU_HOST=linxuhao-ai
LINXUHAO_AI_IP=100.68.74.107

# 存放 GPU 层 bearer token 文件 (GPU_API_TOKEN) 的目录
GPU_LOCK_DIR=/home/linxuhao/.local/state/vip-gpu

# 隧道的会合网名字 (见 ~/cloudflare-tunnel)
CF_EDGE_NETWORK=cloudflare_edge
