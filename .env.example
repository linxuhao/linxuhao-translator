# ==========================================
# vip-gateway 环境变量。docker compose 会自动读同目录的 .env。
# 所有值都有内置默认, 这里列的是"你可能要动"的那些。
# ==========================================

# ---- 仓库外的引擎与权重 (必须存在, 见 media-gen/README-vulkan.md) ----
# 目录下应有: audio.cpp/  stable-diffusion.cpp/  models/  sdmodels2/
# 换机器或换用户名时改这一个就够了。
AUDIOCPP_ROOT=/home/linxuhao/audiocpp

# ---- media-gen ----
VULKAN_DEVICE=1            # 1 = RX 7800 XT; 0 = 7900 XTX (被 vllm 占用)
MAX_IMAGE_SIZE=1024        # 安全上限, 正好在边缘; 1280 会撑爆显存并拖垮宿主机内存
MAX_AUDIO_SECONDS=120      # 诚实上限: 引擎在 120s 处静默截断, 这里把它变成显式 clamped
MAX_SPEECH_CHARS=200       # 护栏: 600 字会挂死 GPU (amdgpu reset), 200 = 约 45 秒旁白
SPEECH_MAX_TOKENS=900      # 护栏: 挡住"输出跑飞"(短台词退化成循环也能生成几分钟)
RETENTION_DAYS=30          # 生成产物保留天数; 0 = 不清理。注意只扫 /generated 顶层,
                           # /actors 和 /subjects 是独立的卷, 永远不会被它删
ENGINE_WAIT_S=180          # 引擎冷启动要从磁盘重读约 10 GB 权重

# ---- 模型 id (要和 media-gen/audio_server.json 里的 id 对上) ----
AUDIO_MODEL_ID=stable-audio
SPEECH_MODEL_ID=qwen3-tts          # VoiceDesign, 只在铸声/定妆时用
CLONE_MODEL_ID=qwen3-tts-base      # Base 克隆, 日常说台词用

# ---- 跨机 (两台机的分工) ----
# linxuhao-ai   (有 GPU) : vllm-qwen / qwen3-asr / media-gen / sd-server / audiocpp-server
# linxuhaserver (无 GPU) : mcp-server / gateway / cloudflared
#
# compose 里所有跨机 URL 的默认值已经写成 http://linxuhao-ai:<port>, 并且两个
# 需要它的服务都带了 extra_hosts —— 所以**两台机都不需要 .env 也不需要 override**,
# 直接 docker compose up -d <本机该跑的服务> 就行。
#
# 只有 AI 机换了 Tailscale 地址时才要动这一个:
LINXUHAO_AI_IP=100.68.74.107

# 想让某个服务改指别处时才用得上 (都有默认值):
# MEDIA_GEN_URL=http://linxuhao-ai:9010
# MEDIA_GEN_PUBLIC_URL=http://linxuhao-ai:9010
# VLLM_URL=http://linxuhao-ai:8000/v1/chat/completions
# ASR_URL=http://linxuhao-ai:9000/v1/chat/completions
# SEARXNG_URL=http://linxuhaserver:8888/search
